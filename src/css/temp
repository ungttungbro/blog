@import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");

:root {
  --base-fonts : "Pretendard", 굴림, 나눔고딕;

[ data-theme = "light" ] { 
  --base_background_image: url(/assets/icons/light-mode-img/light-background.gif);
  --base_task_bar_background_image: url(/assets/icons/light-mode-img/grey-background.gif);
  --base_footer_background_image: url(/assets/icons/light-mode-img/grey-background.gif);

  --base_viewer_title_bar_background_image: url(/assets/icons/light-mode-img/mid-background.gif);
  --base_viewer_title_bar_background_active_image: url(/assets/icons/light-mode-img/mid-dark-background.gif);
  --base_viewer_footer_background_image: url(/assets/icons/light-mode-img/mid-background.gif);
  --base_viewer_background_image: url(/assets/icons/light-mode-img/light-background.gif);

  --base_clarity_filter_background_image: url(/assets/icons/light-mode-img/grey-background.gif);

  --base_background_size: 5.35rem;
  --base_background: #fafcfe;


  --base_font_color: #3a3c3e;
  --base_font_color_b: #6a6c6e;
  --base_font_color_c: #7b7d7f;
  --base_font_meta_color: #7a7c7e;
  
  --base_viewer_title_bar_font_color: #333333;

  --base_font_weight: 600;
  --base_viewer_font_weight: 600;

  --base_task_bar_background_color: #eaecef;
  --base_task_item_background_color : #f2f2f2;
  --base_task_item_background_color_b : #eaecef;
  --base_task_box_background_color : #fafcfe;

  --base_border_line: 0.01rem solid rgba(180, 180, 180, 0.75);
  --base_taskbar_border_line: 0.075rem solid rgba(180, 180, 180, 0.25);
  --base_footer_border_line: 0.075rem solid rgba(180, 180, 180, 0.25);
  --base_hr_border: 0.075rem solid rgba(0, 0, 0, 0.04);
  --base_dash_border: 0.075rem dashed #bbbbbb;

  --base_dark_light_toggle_button: url(/assets/icons/light-mode-img/dark-toggle.png);

  --base_box_background_color: none;
  --base_section_header_box_background_color: none;
  --base_section_header_box_background_color_b: #eaecef;
  --base_section_header_box_font_color: #4a4c4e;

  --base_anchor_tag_hover_color: #e25e0b;
  --base_anchor_tag_hover_color_b: rgba(0, 0, 0, 0.95);
  --base_anchor_tag_hover_text_decoration: none;

  --base_viewer_overay: none;
  --base_viewer_active_overay: #caccce;
  --base_viewer_background_gradient: #fafcfe;
  --base_viewer_title_bar_background: #eaecee;
  --base_window_button_filter_invert: invert(1);

  --base_blog_content_panel_hr : rgba(19, 19, 19, 0.05);
  --base_close_icon_filter_invert : invert(1);

  --base_drop_shadow : none;

  --base_backdrop_filter: none;
  --base_footer_background_color: #1a1a1a;

  --base_task_item_close_background_color_b : #111111;
  --base_viewer_shadow : 
    0 0 0 0.075rem rgba(255,255,255,0.04),
    0 0.3rem 0.6rem rgba(0,0,0,0.45);

  --base_task_items_shadow : 
    0 0 0 0.025rem rgba(255,255,255,0.025),
    0 0.1rem 0.3rem rgba(0,0,0,0.25);
}


[ data-theme = "dark" ] { 
  --base_background_image: url(/assets/icons/dark-mode-img/dark-background.png);

  --base_task_bar_background_image : url(/assets/icons/dark-mode-img/mid-dark-background.gif);
  --base_footer_background_image: url(/assets/icons/dark-mode-img/mid-dark-background.gif);
  --base_clarity_filter_background_image: url(/assets/icons/dark-mode-img/dark-background.png);
  --base_viewer_title_bar_background_image: none;
  --base_viewer_title_bar_background_active_image: none;
  --base_viewer_footer_background_image: none;
  --base_viewer_background_image: none;
  --base_background_size: 12.25rem;

  --base_background: #090909;

  --base_font_color: #eaecee;
  --base_font_color_b: #abadaf;
  --base_font_color_c: #9a9c9e;
  --base_font_meta_color: #9a9c9e;

  --base_viewer_title_bar_font_color: #babcbe;

  --base_font_weight: 400;
  --base_viewer_font_weight: 400;

  --base_border_line: 0px solid #2a2c2e;
  --base_taskbar_border_line: 0.0rem solid rgba(255, 255, 255, 0.07);
  --base_footer_border_line: 0.0rem solid rgba(255, 255, 255, 0.07);
  --base_hr_border: 1px solid rgba(255, 255, 255, 0.06);
  

  --base_dark_light_toggle_button: url(/assets/icons/dark-mode-img/light-toggle.png);

  --base_box_background_color: #181818;
  --base_section_header_box_background_color: #181818;
  --base_section_header_box_background_color_b: #2b2d2f;
  --base_section_header_box_font_color: #eaecee;

  --base_task_bar_background_color: #181818;
  --base_task_item_background_color : #2b2d2f;
  --base_task_item_background_color_b : #3b3d3f;
  --base_task_box_background_color : #191918;

  --base_anchor_tag_hover_color: #ffc900;
  --base_anchor_tag_hover_color_b: #cdcdcd;
  --base_anchor_tag_hover_text_decoration: none;

  --base_dash_border : 0.075rem dashed #555555;
  --base_blog_content_panel_hr : rgba(255,255,255,0.1);
  --base_viewer_border : 0.0rem solid rgba(255,255,255,0.2);
 
  --base_close_icon_filter_invert : none;

  --base_drop_shadow :  drop-shadow(0 0 1.5rem rgba(220, 218, 211, 0.5));
  --base_viewer_shadow : none;
  --base_backdrop_filter: none;
  --base_viewer_overay: none;
  --base_viewer_active_overay: #383838;
  --base_window_button_filter_invert: invert(0);
  /*--base_viewer_background_gradient: linear-gradient(
        to bottom,
        rgba(200, 210, 220, 0.2),
        rgba(180, 190, 210, 0.15)  
    );*/

  /*--base_viewer_background_gradient: linear-gradient(45deg, #222222, #333333);*/
  --base_viewer_background_gradient: #1f1f1f;

  --base_viewer_title_bar_background: #282828;

  --base_footer_background_color : #111111;
  --base_footer_font_color : #caccce;

  --base_task_item_close_background_color_b : #777777;

  --base_viewer_shadow : 
    0 0 0 0.075rem rgba(0, 0, 0, 0.5),
    0 0.3rem 0.6rem rgba(0,0,0,0.45);

  --base_task_items_shadow : 
    0 0 0 0.025rem rgba(255,255,255,0.025),
    0 0.1rem 0.3rem rgba(0,0,0,0.25);
}


::-webkit-scrollbar { width: 0px; }
::-webkit-scrollbar-thumb { background-color: #666666;}
::-webkit-scrollbar-track { background-color: #333333;}


#writings hr {
  margin-top: 0.4rem;
  margin-bottom: 0.2rem;
}

#writings .title {
  line-height: 1.8;
}

#writings .summary {
  line-height: 1.6;
}

#archive { margin-top: 0.75rem; }

#lifelog .latest-post, 
#archive .latest-post {
  line-height: 1.5;
}

#reflection .latest-post {
  line-height: 1.58;
}

#reflection-content {
  padding-top: 1rem;
  color: var(--base_font_color);
  /*text-align: center;*/
}

#site-copyright {
  display:flex;

  align-items: center;
  
  height: 3rem;
  
  color: var(--base_footer_font_color);
  font-weight: bold;
  
  justify-content: center;
  margin: auto;
}

#site-copyright a {
  text-decoration: none;
}

#site-copyright a:hover {
  color: var(--base_footer_font_color);
}

.title_box {
  display: flex;
  background: var(--base_section_header_box_background_color);

  border: var(--base_border_line);
  border-radius: var(--base_border_radius_medium);
  
  font-weight: bold;
  color: var(--base_section_header_box_font_color);
  
  margin: auto;
  margin-bottom: var(--base_margin_size_tiny);
  padding: var(--base_margin_size_medium);

  justify-content: space-between;
  align-items: center;
    
  transition: background-color 0.3s;
  cursor: pointer;
}

/*.title_box figure img {
  display: none;
}*/

.title_box figure {
  display: flex;
  align-items: center;
  margin: 0; /* 기본 margin 제거 중요 */
}

.title-box-more-button {
  font-weight: bold;
  letter-spacing: 0.025rem;
  margin-right: 0.25rem;
}

.title_box:hover {
  background: var(--base_section_header_box_background_color_b);
}

.title-bar {
  position: relative;
  background: var(--base_viewer_title_bar_background); 
  /*background-image: var(--base_viewer_title_bar_background_image);*/

  color: var(--base_viewer_title_bar_font_color);
  font-weight: bold;
}

.title-bar.active {
  background: var(--base_viewer_active_overay);
  /*background-image: var(--base_viewer_title_bar_background_active_image);*/
  color: var(--base_viewer_title_bar_font_color);
}


/* 세로 모드 2단 (portrait) */
@media (orientation: portrait), (max-width: 1152px) {
  html {
    font-size: 2.07vw;
  }

  .viewer { 
    border: none;
  }

  footer {
    border: none
  }

  .blog-post {
    padding: 1.5rem;
    line-height: 2.2;

    font-weight: var(--base_viewer_font_weight);
    font-size: 1.1rem;
  }

  .blog-post-photo-container {
    width: 50%;
  }

  #content-primary {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 1.5rem;
  }

  #content-secondary {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 1.5rem;
  }

  #content-tertiary {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: 1.5rem;
  }

  #logo {
    width: 6rem;
  }

  #taskbar {
    grid-template-columns: 1fr 2.5rem 2rem;
    border: none;
  }

  #task-items {
    display: none;
  }

  #photo-zone .about-photo {
    width: var(--myphoto_width_size); 
    height: var(--myphoto_height_size); ;
  }

  #profile {  
    width: 100%;
    font-size: 0.9rem;
  }

  #profile .profile-thumbnail {
    width: 3.77rem;
    height: 2.8rem;
  }

  #blog-reflection a {
    line-height: 1.6;
  }

  #blog-reflection hr {
    margin-top: 0.45rem;
    margin-bottom: 0.3rem;
  }

  #viewer-maximize-button {
    display: none;
  }

  #viewer-minimize-button {
    display: none;
  }

  #screen-shade-button {
    visibility: hidden;
  }
}

/* 세로 모드 1단 (portrait) */
@media (orientation: portrait) and (max-width: 541px) {
  html {
    font-size: 4.3vw;
  }

  .blog-post {
    padding: 1rem;
    line-height: 2.2;

    font-weight: var(--base_viewer_font_weight);
    font-size: 1.1rem;
  }

  .photolog-header-panel {
    scroll-snap-align: unset;
    scroll-snap-stop: unset;
    scroll-margin-top: 0;

    padding: 1rem;
    line-height: 2.2;

    font-weight: var(--base_viewer_font_weight);
    font-size: 1.1rem;
  }

  .blog-post-photo-container {
    width: 100%;
  }

  #content-primary {
    grid-template-columns: 1fr; /* 1단으로 세로 배치 */
    grid-auto-rows: auto;       /* 아이템 높이에 맞춰 자동 조정 */
    gap: 1rem; 
  }

  #content-secondary, #content-tertiary {
    display: none; /* 세로 모드에서는 보이지 않도록 */
  }

  #logo {
    width: 6rem;
  }

  #taskbar {
    grid-template-columns: 1fr 2.5rem 2rem;
  }

  #task-items {
    display: none;
  }

  #photo-zone .about-photo {
    width: 100%; 
    height: auto;
  }

  #profile {  
    width: 100%;

    margin-top: 1rem;

    font-size: 0.9rem;
  }

  #profile .profile-thumbnail {
    width: 100%;
    height: auto;
  }

  #blog-reflection a {
    line-height: 1.65;
  }

  #blog-writings .summary {
    line-height: 1.5;
  }

  #viewer-maximize-button {
    display: none;
  }

  #viewer-minimize-button {
    display: none;
  }

  #screen-shade-button {
    visibility: hidden;
  }
}

@media (orientation: landscape) and (max-width: 768px) {
  html {
    font-size: 2vw;
  }
}



.photolog-header-panel {
    scroll-snap-align: unset;
    scroll-snap-stop: unset;
    scroll-margin-top: 0;

    padding: 0.75rem;
    padding-bottom: 0.5rem;
    line-height: 2;

    font-weight: var(--base_viewer_font_weight);
    font-size: 1.1rem;
}

.photo-container {
    display: flex;
    width: 100%;
    height: 100%;
    /*max-height: 45rem;*/
    overflow-x: auto;
    overflow-y: hidden;

    transition: height 0.15s ease-out;
}


.photo-container::-webkit-scrollbar {
    display: none;
}

.photo-container > * {
    flex-shrink: 0;
}

.photolog-photo {
    width: auto;
    height: 100%;

    /*max-height: 45rem;*/
    flex-shrink: 0;

    margin: 0;
}

.photolog-footer-panel {
    scroll-snap-align: unset;
    scroll-margin-bottom: 3vh;
}

#viewer-content-photolog-index-viewer .figure-title {
    font-size: 1rem;
    font-weight: var(--base-font-weight);
    color: var(--base-font-color);

    line-height: 1.6;
}

#viewer-content-photolog-index-viewer .figure-content {
    font-size: 0.9rem;
    color: var(--base_font_color_b);

    line-height: 1.6;
}

#viewer-content-photolog-index-viewer hr {
    margin-top: 0.2rem;
    margin-bottom: 0.4rem;
}

#viewer-content-photolog-index-viewer .photolog-header-panel  {
    padding-left: 0.5rem;
    padding-right: 0.75rem;
    padding-top: 0.5rem;
    padding-bottom: 0.25rem;
}

#viewer-content-photolog-index-viewer .photolog-header-panel,
#viewer-content-photolog-index-viewer .photolog-content-panel,
#viewer-content-photolog-index-viewer .photolog-footer-panel  {
    scroll-snap-align: unset;
    scroll-snap-stop: unset;
    scroll-margin-top: unset;
}

#viewer-content-photolog-index-viewer .teaser-figure:hover .figure-title { color: var(--base_anchor_tag_hover_color); }
#viewer-content-photolog-index-viewer .teaser-figure:hover .figure-content { color: var(--base_anchor_tag_hover_color_b); }